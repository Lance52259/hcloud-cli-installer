<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>华为云命令行工具安装程序</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" hostArchitectures="__ARCHS__"/>
    <choices-outline>
        <line choice="hcloud"/>
    </choices-outline>
    <choice id="hcloud" visible="false" title="华为云命令行工具">
        <pkg-ref id="com.huaweicloud.hcloud"/>
    </choice>
    <pkg-ref id="com.huaweicloud.hcloud" version="__VERSION__" auth="root">hcloud-component.pkg</pkg-ref>
</installer-gui-script>
